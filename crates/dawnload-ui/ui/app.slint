// Dawnload's main window, from docs/DESIGN.md. One toolkit draws everything; the Rust side feeds
// it rows built from the core's snapshot + diff stream (see src/bridge.rs), and gets back what
// the person did as callbacks.

import { ListView, ScrollView } from "std-widgets.slint";
import { Theme, S } from "theme.slint";
import { RowData, CutD, Pill, SectionHeader, Stat, InspectorSection, IconButton, SectionTitle } from "parts.slint";
import { SettingsPage, FirstRunCard, AboutCard, Prefs, ToolRow, Choices } from "settings.slint";

export { Theme, S, RowData, Prefs, ToolRow }

export struct FilterTab {
    title: string,
    count: int,
}

export struct FileRow {
    name: string,
    size: string,
    path: string,
}

export struct InspectorData {
    present: bool,
    id: int,
    title: string,
    word: string,
    status: int,
    fill: float,
    loading: bool,
    source: string,
    percent: string,
    numbers: string,
    torrent: bool,
    peers: string,
    seeds: string,
    down: string,
    up: string,
    uploaded: string,
    ratio: string,
    options: string,
    engine: string,
    failure: string,
    hint: string,
    log: string,
    primary: string,
    has-file: bool,
}

// What the intake chips show (the defaults for the next download).
export struct Chips {
    format: int,
    format-enabled: bool,
    engine: int,
    // "Auto · yt-dlp" once a link is pasted.
    engine-label: string,
    polish: bool,
    playlist: bool,
    impersonate: int,
    cookies-available: bool,
    cookies: bool,
    folder: string,
}

// A queued row's drag handle reorders it among waiting items; Alt+↑/↓ does the same.
component ItemRow inherits Rectangle {
    in property <RowData> data;
    in property <bool> selected;
    in property <bool> eased;
    callback clicked;
    callback double-clicked;
    callback act(string);
    callback reorder(int);
    private property <length> drag-dy;
    private property <bool> pressing;
    private property <bool> handle-hover;
    private property <bool> dragging: self.pressing && abs(self.drag-dy) > 4px;
    height: 60px;
    z: dragging ? 10 : 0;
    accessible-role: list-item;
    accessible-label: root.data.a11y;
    accessible-item-selectable: true;
    accessible-item-selected: root.selected;
    accessible-action-default => { root.clicked(); }

    menu := ContextMenuArea {
        Menu {
            if root.data.status == S.pulling || root.data.status == S.polishing : MenuItem { title: "Pause"; activated => { root.act("pause"); } }
            if root.data.status == S.queued : MenuItem { title: "Download Now"; activated => { root.act("resume"); } }
            if root.data.status == S.paused : MenuItem { title: "Resume"; activated => { root.act("resume"); } }
            if root.data.status == S.failed : MenuItem { title: "Retry"; activated => { root.act("resume"); } }
            if root.data.status == S.seeding : MenuItem { title: "Stop Seeding"; activated => { root.act("stop-seeding"); } }
            if root.data.status == S.queued : MenuItem { title: "Hold Back"; activated => { root.act("pause"); } }
            if root.data.status == S.kept || root.data.status == S.seeding : MenuItem { title: "Open"; enabled: root.data.has-file; activated => { root.act("open"); } }
            MenuItem { title: Theme.reveal; activated => { root.act("reveal"); } }
            MenuItem { title: "Copy Link"; activated => { root.act("copy-link"); } }
            if root.data.status == S.queued : MenuSeparator {}
            if root.data.status == S.queued : MenuItem { title: "Move to Top"; activated => { root.act("top"); } }
            if root.data.status == S.queued : MenuItem { title: "Move to Bottom"; activated => { root.act("bottom"); } }
            MenuSeparator {}
            MenuItem { title: "Remove"; activated => { root.act("remove"); } }
        }

        Rectangle {
            y: root.dragging ? root.drag-dy : 0px;
            width: root.width; height: root.height;
            background: root.selected || root.dragging ? Theme.raised : touch.has-hover ? Theme.raised.with-alpha(0.45) : transparent;
            border-width: root.dragging ? 1px : 0px;
            border-color: Theme.rule;
            // The spine: a selected row shows the D's straight edge.
            if root.selected : Rectangle {
                x: 0; width: 3px; height: parent.height;
                background: Theme.link;
            }
            // The row's TouchArea takes every button, so it opens the context menu itself: Slint's
            // ContextMenuArea only sees a right-click its children didn't take.
            touch := TouchArea {
                clicked => { root.clicked(); }
                double-clicked => { root.double-clicked(); }
                pointer-event(event) => {
                    if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                        root.clicked();
                        menu.show({ x: self.mouse-x, y: self.mouse-y });
                    }
                }
            }
            HorizontalLayout {
                padding-left: 24px; padding-right: 16px; spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    CutD {
                        height: 32px;
                        status: root.data.status;
                        fill: root.data.fill;
                        loading: root.data.loading;
                        eased: root.eased;
                        punch: root.selected || touch.has-hover || root.dragging ? Theme.raised : Theme.canvas;
                    }
                }
                VerticalLayout {
                    alignment: center; spacing: 4px;
                    horizontal-stretch: 1;
                    Text {
                        text: root.data.title;
                        color: Theme.text; font-size: 13px; font-weight: 600;
                        overflow: elide;
                        accessible-role: none;
                    }
                    Text {
                        text: root.data.subline;
                        color: root.data.status == S.failed ? Theme.failed : Theme.text2;
                        font-family: Theme.mono; font-size: 11px;
                        overflow: elide;
                        accessible-role: none;
                    }
                }
                // Hover actions: shortcuts for the context menu, never the only way. Shown while the
                // pointer is on the row or on the pill itself (the row loses its hover to the pill).
                if root.data.status == S.kept || root.data.status == S.failed || root.data.status == S.paused : action := Pill {
                    y: (parent.height - self.height) / 2;
                    visible: touch.has-hover || self.hovered;
                    width: self.visible ? self.preferred-width : 0px;
                    label: root.data.status == S.kept ? Theme.reveal : root.data.status == S.failed ? "Retry" : "Resume";
                    clicked => { root.act(root.data.status == S.kept ? "reveal" : "resume"); }
                }
                if root.data.trailing != "" && !(touch.has-hover && root.data.status != S.pulling) : Text {
                    text: root.data.trailing; vertical-alignment: center;
                    color: Theme.text; font-family: Theme.mono; font-size: 12px; font-weight: 700;
                    accessible-role: none;
                }
                // The drag handle on waiting rows.
                if root.data.status == S.queued : Rectangle {
                    width: 24px;
                    opacity: touch.has-hover || root.handle-hover || root.dragging || root.selected ? 1 : 0;
                    accessible-role: none;
                    Path {
                        width: 10px; height: 16px;
                        viewbox-width: 10; viewbox-height: 16;
                        commands: "M 0.8 3 A 1.2 1.2 0 1 0 3.2 3 A 1.2 1.2 0 1 0 0.8 3 Z M 6.8 3 A 1.2 1.2 0 1 0 9.2 3 A 1.2 1.2 0 1 0 6.8 3 Z M 0.8 8 A 1.2 1.2 0 1 0 3.2 8 A 1.2 1.2 0 1 0 0.8 8 Z M 6.8 8 A 1.2 1.2 0 1 0 9.2 8 A 1.2 1.2 0 1 0 6.8 8 Z M 0.8 13 A 1.2 1.2 0 1 0 3.2 13 A 1.2 1.2 0 1 0 0.8 13 Z M 6.8 13 A 1.2 1.2 0 1 0 9.2 13 A 1.2 1.2 0 1 0 6.8 13 Z";
                        fill: Theme.text2;
                    }
                    handle-touch := TouchArea {
                        mouse-cursor: root.dragging ? grabbing : grab;
                        changed has-hover => { root.handle-hover = self.has-hover; }
                        moved => { root.drag-dy = self.mouse-y - self.pressed-y; }
                        pointer-event(event) => {
                            if event.kind == PointerEventKind.down {
                                root.pressing = true;
                            }
                            if event.kind == PointerEventKind.up {
                                root.pressing = false;
                                if abs(root.drag-dy) > 4px {
                                    root.reorder(round(root.drag-dy / 60px));
                                } else {
                                    root.clicked();
                                }
                                root.drag-dy = 0px;
                            }
                        }
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Dawnload";
    icon: @image-url("../assets/icon-256.png");
    preferred-width: 1080px;
    preferred-height: 720px;
    min-width: 780px;
    min-height: 540px;
    background: Theme.canvas;
    default-font-size: 13px;

    // Intake
    in-out property <string> paste-text;
    in property <string> detection;
    // 0 neutral, 1 warning, 2 failed.
    in property <int> detection-tone;
    // 0 nothing, 1 web link, 2 magnet, 3 file.
    in property <int> detection-kind;
    in property <bool> can-submit: true;
    in property <Chips> chips: { format: 0, format-enabled: true, engine: 0, engine-label: "Auto", polish: true, folder: "Dawnload" };
    // Header
    in property <string> tools-text: "Checking tools";
    in property <bool> tools-ok: true;
    in property <string> mode-note;
    // The empty list becomes a setup card when this tool is missing ("yt-dlp").
    in property <string> missing-tool;
    in property <bool> tools-busy;
    // List
    in property <[RowData]> rows;
    in property <[FilterTab]> filters;
    in-out property <int> filter: 0;
    in property <string> queue-label;
    in property <string> empty-line: "Paste a link to start.";
    in-out property <int> selected-id: -1;
    in-out property <length> list-scroll <=> list.content-y;
    out property <length> list-height: list.visible-height;
    // Inspector
    in property <InspectorData> inspector;
    in property <[FileRow]> inspector-files;
    in-out property <bool> show-inspector: true;
    // Pages over the list: 0 none, 1 Settings, 2 first run, 3 About.
    in-out property <int> page: 0;
    in-out property <int> settings-tab: 0;
    in property <Prefs> prefs;
    in property <[ToolRow]> tools;
    in property <string> js-line;
    in property <bool> js-ok: true;
    in property <string> tools-note;
    in property <string> version;
    // A sentence for a moment at the bottom of the window ("yt-dlp updated to 2026.11.01.").
    in property <string> notice;
    // Something is being dragged over the window.
    in property <bool> drop-hover;
    // Measurement switch: ease every row's fill (see Scripts/measure-ui.sh).
    in property <bool> ease-rows: false;

    callback paste-edited(string);
    // Download (start: true) or Add to Queue (start: false).
    callback submit(string, bool);
    callback set-option(string, int);
    callback command(string);
    callback tool-action(string, string);
    callback select-filter(int);
    callback select(int);
    callback move-selection(int);
    callback item-action(int, string);
    callback reorder(int, int);
    callback queue-action();
    callback inspector-toggled(bool);

    // Copies text with Slint's own clipboard (Wayland, X11, Windows and macOS alike).
    public function copy-text(text: string) {
        clipboard.text = text;
        clipboard.select-all();
        clipboard.copy();
        clipboard.text = "";
    }
    public function focus-paste() {
        root.page = 0;
        paste.focus();
        paste.select-all();
    }
    // ⇧⌘V: paste into the field and download it.
    public function paste-and-download() {
        root.page = 0;
        paste.focus();
        paste.select-all();
        paste.paste();
        root.paste-edited(paste.text);
        root.submit(paste.text, true);
    }

    // The paste field has the keyboard at launch: Ctrl+V and Return are all it takes.
    forward-focus: paste;

    // The keyboard map (DESIGN.md › Keyboard), with Ctrl on Windows and Linux and ⌘ on macOS.
    // Keys the focused control doesn't use bubble up to here.
    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                if root.page != 0 { root.page = 0; return accept; }
                if root.selected-id >= 0 { root.selected-id = -1; root.select(-1); return accept; }
                return reject;
            }
            if (event.modifiers.control || event.modifiers.meta) {
                if event.modifiers.shift {
                    if event.text == "v" || event.text == "V" { root.paste-and-download(); return accept; }
                    if event.text == "a" || event.text == "A" { root.submit(root.paste-text, false); return accept; }
                    if event.text == "s" || event.text == "S" { root.command("start-queue"); return accept; }
                    if event.text == "o" || event.text == "O" { root.command("choose-folder"); return accept; }
                    if (event.text == "r" || event.text == "R") && root.selected-id >= 0 { root.item-action(root.selected-id, "reveal"); return accept; }
                    return reject;
                }
                if event.text == "l" || event.text == "L" { root.focus-paste(); return accept; }
                if event.text == "d" || event.text == "D" { root.submit(root.paste-text, true); return accept; }
                if event.text == "." { root.command("pause-all"); return accept; }
                if event.text == "r" || event.text == "R" { root.command("check-tools"); return accept; }
                if event.text == "," { root.page = 1; return accept; }
                if event.text == "i" || event.text == "I" { root.show-inspector = !root.show-inspector; root.inspector-toggled(root.show-inspector); return accept; }
                if event.text == "q" || event.text == "Q" { root.command("quit"); return accept; }
                if event.text == Key.Return && root.selected-id >= 0 { root.item-action(root.selected-id, "resume"); return accept; }
                if event.text == "1" { root.filter = 0; root.select-filter(0); return accept; }
                if event.text == "2" { root.filter = 1; root.select-filter(1); return accept; }
                if event.text == "3" { root.filter = 2; root.select-filter(2); return accept; }
                if event.text == "4" { root.filter = 3; root.select-filter(3); return accept; }
                if event.text == "5" { root.filter = 4; root.select-filter(4); return accept; }
                return reject;
            }
            if root.page != 0 { return reject; }
            if event.modifiers.alt && event.text == Key.UpArrow && root.selected-id >= 0 { root.reorder(root.selected-id, -1); return accept; }
            if event.modifiers.alt && event.text == Key.DownArrow && root.selected-id >= 0 { root.reorder(root.selected-id, 1); return accept; }
            if event.text == Key.UpArrow { root.move-selection(-1); return accept; }
            if event.text == Key.DownArrow { root.move-selection(1); return accept; }
            if (event.text == Key.Delete || event.text == Key.Backspace) && root.selected-id >= 0 {
                root.item-action(root.selected-id, "remove"); return accept;
            }
            if event.text == Key.Return && root.selected-id >= 0 { root.item-action(root.selected-id, "primary"); return accept; }
            reject
        }

        // The inspector hides itself below 960 px of window width.
        private property <length> inspector-width: root.show-inspector && root.width >= 960px ? 300px : 0px;

        // MARK: Main column
        VerticalLayout {
            x: 0; y: 0;
            width: parent.width - parent.inspector-width;
            height: parent.height;

            // Header
            Rectangle {
                height: 52px;
                accessible-role: groupbox;
                accessible-label: "Dawnload";
                HorizontalLayout {
                    padding-left: 24px; padding-right: 16px; spacing: 10px;
                    Image {
                        source: @image-url("../../../docs/brand/logo/dawnload-mark.svg");
                        height: 18px; width: 15px; y: (parent.height - self.height) / 2;
                        accessible-role: none;
                    }
                    Image {
                        source: Theme.dark ? @image-url("../../../docs/brand/logo/dawnload-wordmark-paper.svg") : @image-url("../../../docs/brand/logo/dawnload-wordmark-ink.svg");
                        height: 14px; width: 92px; y: (parent.height - self.height) / 2;
                        image-fit: contain;
                        accessible-label: "Dawnload";
                    }
                    if root.mode-note != "" : Text {
                        text: root.mode-note; vertical-alignment: center;
                        color: Theme.text2; font-family: Theme.mono; font-size: 10px;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    // The tools pill: a dot and "Tools ready", or what's missing. Opens Settings › Tools.
                    Rectangle {
                        height: 26px; y: (parent.height - self.height) / 2;
                        width: tools-row.preferred-width;
                        border-radius: 13px; border-width: 1px; border-color: Theme.rule;
                        background: tools-touch.has-hover ? Theme.raised : transparent;
                        accessible-role: button;
                        accessible-label: root.tools-text;
                        accessible-description: "Opens Settings, Tools";
                        accessible-action-default => { root.settings-tab = 2; root.page = 1; }
                        tools-row := HorizontalLayout {
                            padding-left: 10px; padding-right: 12px; spacing: 6px;
                            Rectangle {
                                width: 7px; height: 7px; y: (parent.height - self.height) / 2; border-radius: 3.5px;
                                background: root.tools-ok ? Theme.kept : Theme.failed;
                            }
                            Text { text: root.tools-text; vertical-alignment: center; color: Theme.text2; font-size: 11px; accessible-role: none; }
                        }
                        tools-touch := TouchArea { mouse-cursor: pointer; clicked => { root.settings-tab = 2; root.page = 1; } }
                        tools-fs := FocusScope {
                            focus-on-click: false;
                            key-pressed(event) => {
                                if event.text == " " || event.text == Key.Return { root.settings-tab = 2; root.page = 1; return accept; }
                                reject
                            }
                        }
                        if tools-fs.has-focus : Rectangle { border-radius: 13px; border-width: 2px; border-color: Theme.link; }
                    }
                    Pill {
                        y: (parent.height - self.height) / 2;
                        label: "Inspector"; on: root.show-inspector; toggle: true;
                        hint: Theme.mod-key + "+I";
                        clicked => { root.show-inspector = !root.show-inspector; root.inspector-toggled(root.show-inspector); }
                    }
                    Rectangle {
                        width: 28px; height: 28px; y: (parent.height - self.height) / 2;
                        more-menu := ContextMenuArea {
                            Menu {
                                MenuItem { title: "Settings…"; activated => { root.page = 1; } }
                                MenuItem { title: "Check Tools Again"; activated => { root.command("check-tools"); } }
                                MenuSeparator {}
                                MenuItem { title: "Start Queue"; activated => { root.command("start-queue"); } }
                                MenuItem { title: "Pause All"; activated => { root.command("pause-all"); } }
                                MenuSeparator {}
                                MenuItem { title: "About Dawnload"; activated => { root.page = 3; } }
                                MenuItem { title: "Quit Dawnload"; activated => { root.command("quit"); } }
                            }
                        }
                        IconButton {
                            label: "More";
                            clicked => { more-menu.show({ x: 0px, y: 32px }); }
                        }
                    }
                }
            }

            // Intake
            VerticalLayout {
                padding-left: 24px; padding-right: 24px; padding-top: 4px; spacing: 8px;
                Rectangle {
                    height: 56px;
                    background: Theme.raised;
                    border-radius: Theme.radius-spine;
                    border-width: paste.has-focus ? 2px : 1px;
                    border-color: paste.has-focus ? Theme.link : Theme.rule;
                    if paste.has-focus : Rectangle {
                        x: 0; width: 3px; height: parent.height; background: Theme.link;
                    }
                    HorizontalLayout {
                        padding-left: 18px; padding-right: 8px; spacing: 12px;
                        // What was detected: a link, a magnet or a file.
                        Rectangle {
                            width: 18px;
                            accessible-role: none;
                            Path {
                                width: 16px; height: 16px;
                                viewbox-width: 16; viewbox-height: 16;
                                commands: root.detection-kind == 2
                                    ? "M 4 2 L 4 8 A 4 4 0 0 0 12 8 L 12 2 M 4 5 L 7 5 M 9 5 L 12 5"
                                    : root.detection-kind == 3
                                    ? "M 4 1.5 L 9.5 1.5 L 12.5 4.5 L 12.5 14.5 L 4 14.5 Z M 9.5 1.5 L 9.5 4.5 L 12.5 4.5"
                                    : "M 6.5 9.5 L 9.5 6.5 M 7 4.5 L 8.5 3 A 2.5 2.5 0 0 1 13 7.5 L 11.5 9 M 9 11.5 L 7.5 13 A 2.5 2.5 0 0 1 3 8.5 L 4.5 7";
                                stroke: root.detection-kind == 0 ? Theme.text2 : Theme.link;
                                stroke-width: 1.5px; stroke-line-cap: round; stroke-line-join: round;
                            }
                        }
                        // The field scrolls a long link inside itself; its text must never widen the row and
                        // push the Download pill out.
                        Rectangle {
                            horizontal-stretch: 1;
                            min-width: 0px;
                            preferred-width: 0px;
                            clip: true;
                            if root.paste-text == "" : Text {
                                width: parent.width; height: parent.height;
                                text: "Paste a link to a video, a playlist, a gallery, a file or a magnet";
                                vertical-alignment: center;
                                color: Theme.text2; font-family: Theme.mono; font-size: 13px;
                                overflow: elide;
                                accessible-role: none;
                            }
                            paste := TextInput {
                                width: parent.width; height: parent.height;
                                text <=> root.paste-text;
                                vertical-alignment: center;
                                color: Theme.text; font-family: Theme.mono; font-size: 13px;
                                single-line: true;
                                selection-background-color: Theme.link.with-alpha(0.35);
                                accessible-label: "Link to download";
                                accessible-placeholder-text: "Paste a link to a video, a playlist, a gallery, a file or a magnet";
                                accessible-description: root.detection;
                                edited => { root.paste-edited(self.text); }
                                key-pressed(event) => {
                                    // ⌥Return adds to the queue without starting it.
                                    if event.text == Key.Return && event.modifiers.alt {
                                        root.submit(self.text, false);
                                        return accept;
                                    }
                                    reject
                                }
                                accepted => { root.submit(self.text, true); }
                            }
                        }
                        Pill {
                            y: (parent.height - self.height) / 2;
                            height: 40px;
                            primary: true; mark: "↓"; label: "Download"; pull: true;
                            label-size: 13px;
                            enabled: root.can-submit && root.paste-text != "";
                            hint: "Return. " + (Theme.mod-key == "⌘" ? "⌥Return" : "Alt+Return") + " adds it to the queue without starting.";
                            clicked => { root.submit(root.paste-text, true); }
                        }
                    }
                }
                Text {
                    height: 16px;
                    text: root.detection;
                    color: root.detection-tone == 2 ? Theme.failed : root.detection-tone == 1 ? Theme.text : Theme.text2;
                    font-family: Theme.mono; font-size: 11px;
                    overflow: elide;
                    accessible-live-region: polite;
                }
                // The options chips: how the next item downloads. They stick.
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        width: format-pill.preferred-width; height: 28px;
                        format-menu := ContextMenuArea {
                            Menu {
                                MenuItem { title: "Best (highest quality)"; icon: root.chips.format == 0 ? Theme.check : @image-url(""); activated => { root.set-option("format", 0); } }
                                MenuItem { title: "Compatible (MP4 and M4A)"; icon: root.chips.format == 1 ? Theme.check : @image-url(""); activated => { root.set-option("format", 1); } }
                                MenuItem { title: "Audio only (M4A, needs ffmpeg)"; icon: root.chips.format == 2 ? Theme.check : @image-url(""); activated => { root.set-option("format", 2); } }
                            }
                        }
                        format-pill := Pill {
                            label: root.chips.format-enabled ? Choices.formats[root.chips.format] : "Original files";
                            chevron: root.chips.format-enabled; on: true; enabled: root.chips.format-enabled;
                            hint: root.chips.format-enabled ? "Format" : "gallery-dl keeps the original files";
                            clicked => { format-menu.show({ x: 0px, y: 32px }); }
                        }
                    }
                    Rectangle {
                        width: engine-pill.preferred-width; height: 28px;
                        engine-menu := ContextMenuArea {
                            Menu {
                                MenuItem { title: "Auto"; icon: root.chips.engine == 0 ? Theme.check : @image-url(""); activated => { root.set-option("engine", 0); } }
                                MenuItem { title: "yt-dlp"; icon: root.chips.engine == 1 ? Theme.check : @image-url(""); activated => { root.set-option("engine", 1); } }
                                MenuItem { title: "gallery-dl"; icon: root.chips.engine == 2 ? Theme.check : @image-url(""); activated => { root.set-option("engine", 2); } }
                                MenuItem { title: "Direct (Dawnload's own)"; icon: root.chips.engine == 3 ? Theme.check : @image-url(""); activated => { root.set-option("engine", 3); } }
                            }
                        }
                        engine-pill := Pill {
                            label: root.chips.engine-label; chevron: true; on: true;
                            hint: "Engine";
                            clicked => { engine-menu.show({ x: 0px, y: 32px }); }
                        }
                    }
                    Pill {
                        label: "Polish"; mark: root.chips.polish ? "✓" : ""; on: root.chips.polish; toggle: true;
                        hint: "ffmpeg merges, remuxes to MP4 and moves the index to the front";
                        clicked => { root.set-option("polish", root.chips.polish ? 0 : 1); }
                    }
                    Pill {
                        label: "Playlist"; mark: root.chips.playlist ? "✓" : ""; on: root.chips.playlist; toggle: true;
                        hint: "Download the whole playlist the link belongs to";
                        clicked => { root.set-option("playlist", root.chips.playlist ? 0 : 1); }
                    }
                    Rectangle {
                        width: imp-pill.preferred-width; height: 28px;
                        imp-menu := ContextMenuArea {
                            Menu {
                                for name[i] in Choices.impersonations : MenuItem {
                                    title: name;
                                    icon: root.chips.impersonate == i ? Theme.check : @image-url("");
                                    activated => { root.set-option("impersonate", i); }
                                }
                            }
                        }
                        imp-pill := Pill {
                            label: root.chips.impersonate == 0 ? "Impersonate" : Choices.impersonations[root.chips.impersonate];
                            mark: root.chips.impersonate == 0 ? "" : "✓";
                            on: root.chips.impersonate != 0; chevron: true;
                            hint: "Look like a browser to sites that refuse yt-dlp";
                            clicked => { imp-menu.show({ x: 0px, y: 32px }); }
                        }
                    }
                    if root.chips.cookies-available : Pill {
                        label: "cookies.txt"; mark: root.chips.cookies ? "✓" : ""; on: root.chips.cookies; toggle: true;
                        hint: "Send the cookies.txt from Settings › Access";
                        clicked => { root.set-option("cookies", root.chips.cookies ? 0 : 1); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Rectangle {
                        width: folder-pill.preferred-width; height: 28px;
                        folder-menu := ContextMenuArea {
                            Menu {
                                MenuItem { title: "Choose Folder…"; activated => { root.command("choose-folder"); } }
                                MenuItem { title: Theme.reveal; activated => { root.command("show-folder"); } }
                            }
                        }
                        folder-pill := Pill {
                            label: "→ " + root.chips.folder; chevron: true;
                            hint: "Where files go";
                            clicked => { folder-menu.show({ x: 0px, y: 32px }); }
                        }
                    }
                }
            }

            // Filter tabs and the queue control
            HorizontalLayout {
                padding-left: 24px; padding-right: 24px; padding-top: 16px; padding-bottom: 8px; spacing: 4px;
                HorizontalLayout {
                    spacing: 4px;
                    accessible-role: tab-list;
                    accessible-label: "Filter";
                    for ftab[i] in root.filters : Rectangle {
                        height: 28px;
                        width: tab-row.preferred-width;
                        border-radius: 14px;
                        background: root.filter == i ? Theme.raised : tab-touch.has-hover ? Theme.raised.with-alpha(0.5) : transparent;
                        border-width: root.filter == i ? 1px : 0;
                        border-color: Theme.rule;
                        accessible-role: tab;
                        accessible-label: ftab.title + ", " + ftab.count;
                        accessible-item-selected: root.filter == i;
                        accessible-action-default => { root.filter = i; root.select-filter(i); }
                        tab-row := HorizontalLayout {
                            padding-left: 12px; padding-right: 12px; spacing: 6px;
                            Text {
                                text: ftab.title; vertical-alignment: center;
                                color: root.filter == i ? Theme.text : Theme.text2; font-size: 12px; font-weight: 600;
                                accessible-role: none;
                            }
                            Text {
                                text: ftab.count; vertical-alignment: center;
                                color: ftab.count == 0 ? Theme.text2.with-alpha(0.5) : Theme.text2;
                                font-family: Theme.mono; font-size: 11px; font-weight: 700;
                                accessible-role: none;
                            }
                        }
                        tab-touch := TouchArea { mouse-cursor: pointer; clicked => { root.filter = i; root.select-filter(i); } }
                        tab-fs := FocusScope {
                            focus-on-click: false;
                            key-pressed(event) => {
                                if event.text == " " || event.text == Key.Return { root.filter = i; root.select-filter(i); return accept; }
                                reject
                            }
                        }
                        if tab-fs.has-focus : Rectangle { border-radius: 14px; border-width: 2px; border-color: Theme.link; }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                if root.queue-label != "" : Pill {
                    label: root.queue-label; on: true;
                    hint: root.queue-label == "Pause All" ? Theme.mod-key + "+." : root.queue-label == "Start Queue" ? Theme.mod-key + "+Shift+S" : "";
                    clicked => { root.queue-action(); }
                }
                Rectangle {
                    width: 28px; height: 28px;
                    queue-menu := ContextMenuArea {
                        Menu {
                            MenuItem { title: "Clear Kept"; activated => { root.command("clear-kept"); } }
                            MenuItem { title: "Clear Failed"; activated => { root.command("clear-failed"); } }
                            MenuItem { title: "Remove Waiting"; activated => { root.command("remove-waiting"); } }
                        }
                    }
                    IconButton {
                        label: "Queue options";
                        clicked => { queue-menu.show({ x: -150px, y: 32px }); }
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.rule; }

            // The list
            Rectangle {
                vertical-stretch: 1;
                list := ListView {
                    accessible-role: AccessibleRole.list;
                    accessible-label: "Downloads";
                    for row in root.rows : Rectangle {
                        height: row.kind == 0 ? 32px : 60px;
                        if row.kind == 0 : SectionHeader {
                            width: parent.width;
                            title: row.header; count: row.count;
                        }
                        if row.kind == 1 : ItemRow {
                            width: parent.width;
                            data: row;
                            selected: row.id == root.selected-id;
                            eased: root.ease-rows;
                            clicked => { root.selected-id = row.id; root.select(row.id); keys.focus(); }
                            double-clicked => { root.item-action(row.id, "primary"); }
                            act(what) => { root.item-action(row.id, what); }
                            reorder(delta) => { root.reorder(row.id, delta); }
                        }
                    }
                }
                // Empty states (DESIGN.md › States of the window).
                if root.rows.length == 0 && root.filter == 0 && root.missing-tool != "" : VerticalLayout {
                    alignment: center; spacing: 14px; padding: 24px;
                    HorizontalLayout { alignment: center; CutD { height: 64px; status: S.failed; fill: 1; } }
                    Text {
                        text: "Dawnload needs " + root.missing-tool + " to download from the web.";
                        horizontal-alignment: center; wrap: word-wrap;
                        color: Theme.text; font-size: 15px; font-weight: 600;
                    }
                    Text {
                        text: "It installs the official build, checks it before it runs and keeps it current. Plain file links work without it.";
                        horizontal-alignment: center; wrap: word-wrap; color: Theme.text2;
                    }
                    HorizontalLayout {
                        alignment: center; spacing: 8px;
                        Pill {
                            label: root.tools-busy ? "Installing…" : "Install " + root.missing-tool; on: true; enabled: !root.tools-busy;
                            clicked => { root.command("install-missing"); }
                        }
                        Pill { label: "Check Again"; hint: Theme.mod-key + "+R"; enabled: !root.tools-busy; clicked => { root.command("check-tools"); } }
                        Pill { label: "Tools…"; clicked => { root.settings-tab = 2; root.page = 1; } }
                    }
                }
                if root.rows.length == 0 && !(root.filter == 0 && root.missing-tool != "") : VerticalLayout {
                    alignment: center; spacing: 16px;
                    if root.filter == 0 : HorizontalLayout {
                        alignment: center;
                        CutD { height: 96px; status: S.pulling; fill: 0; }
                    }
                    Text {
                        text: root.empty-line; horizontal-alignment: center;
                        color: root.filter == 0 ? Theme.text : Theme.text2;
                        font-family: root.filter == 0 ? Theme.display : "";
                        font-size: root.filter == 0 ? 22px : 13px;
                        font-weight: root.filter == 0 ? 800 : 400;
                    }
                    if root.filter == 0 : Text {
                        text: "Video, audio, galleries and files from the web, kept on " + Theme.computer + ".";
                        horizontal-alignment: center; color: Theme.text2;
                    }
                    if root.filter == 0 : HorizontalLayout {
                        alignment: center; spacing: 20px;
                        Text {
                            text: (Theme.mod-key == "⌘" ? "⇧⌘V" : "Ctrl+Shift+V") + "  Paste and Download";
                            color: Theme.text2; font-family: Theme.mono; font-size: 11px;
                        }
                        Text {
                            text: (Theme.mod-key == "⌘" ? "⌥↩" : "Alt+Enter") + "  Add to Queue";
                            color: Theme.text2; font-family: Theme.mono; font-size: 11px;
                        }
                    }
                }
            }
        }

        // MARK: Inspector
        if inspector-width > 0 : Rectangle {
            x: parent.width - parent.inspector-width; y: 0;
            width: parent.inspector-width; height: parent.height;
            background: Theme.raised;
            accessible-role: groupbox;
            accessible-label: "Inspector";
            Rectangle { x: 0; width: 1px; height: parent.height; background: Theme.rule; }
            if !root.inspector.present : Text {
                x: 24px; width: parent.width - 48px;
                text: "Select a download to see its files, options and log.";
                wrap: word-wrap; vertical-alignment: center; horizontal-alignment: center;
                color: Theme.text2;
            }
            if root.inspector.present : ScrollView {
                VerticalLayout {
                    padding: 24px; spacing: 14px;
                    // Status
                    HorizontalLayout {
                        spacing: 12px; alignment: start;
                        CutD { height: 44px; status: root.inspector.status; fill: root.inspector.fill; loading: root.inspector.loading; punch: Theme.raised; eased: true; }
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: root.inspector.word;
                                color: root.inspector.status == S.failed ? Theme.failed : root.inspector.status == S.kept ? Theme.kept : Theme.text;
                                font-size: 13px; font-weight: 700;
                            }
                            Text { text: root.inspector.engine; color: Theme.text2; font-family: Theme.mono; font-size: 10px; }
                        }
                    }
                    Text { text: root.inspector.title; color: Theme.text; font-size: 15px; font-weight: 600; wrap: word-wrap; }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: root.inspector.source; color: Theme.text2; font-family: Theme.mono; font-size: 10px; wrap: char-wrap; horizontal-stretch: 1; }
                    }
                    HorizontalLayout {
                        alignment: start;
                        Pill { label: "Copy Link"; height: 24px; label-size: 11px; clicked => { root.item-action(root.inspector.id, "copy-link"); } }
                    }
                    // Progress: the big number is the one place Unbounded appears.
                    if root.inspector.percent != "" : Text {
                        text: root.inspector.percent;
                        color: Theme.text; font-family: Theme.display; font-size: 40px; font-weight: 800;
                        accessible-role: progress-indicator;
                        accessible-label: "Progress";
                        accessible-value: root.inspector.percent;
                    }
                    if root.inspector.numbers != "" : Text {
                        text: root.inspector.numbers; color: Theme.text2; font-family: Theme.mono; font-size: 11px; wrap: word-wrap;
                    }
                    if root.inspector.failure != "" : VerticalLayout {
                        spacing: 4px;
                        Text { text: root.inspector.failure; color: Theme.failed; wrap: word-wrap; font-weight: 600; }
                        Text { text: root.inspector.hint; color: Theme.text2; wrap: word-wrap; }
                    }
                    // Swarm (torrents)
                    if root.inspector.torrent : InspectorSection {
                        title: "SWARM";
                        HorizontalLayout {
                            spacing: 16px;
                            Stat { label: "Peers"; value: root.inspector.peers; }
                            Stat { label: "Seeds"; value: root.inspector.seeds; }
                            Stat { label: "Ratio"; value: root.inspector.ratio; }
                        }
                        HorizontalLayout {
                            spacing: 16px;
                            Stat { label: "Down"; value: root.inspector.down; }
                            Stat { label: "Up"; value: root.inspector.up; }
                            Stat { label: "Uploaded"; value: root.inspector.uploaded; }
                        }
                    }
                    InspectorSection {
                        title: "FILES";
                        for file in root.inspector-files : Rectangle {
                            height: file-row.preferred-height;
                            accessible-role: button;
                            accessible-label: file.name + ", " + file.size;
                            accessible-description: Theme.reveal;
                            accessible-action-default => { root.command("reveal-file:" + file.path); }
                            file-row := HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: file.name; font-family: Theme.mono; font-size: 11px; overflow: elide; horizontal-stretch: 1;
                                    color: file-touch.has-hover ? Theme.link : Theme.text;
                                }
                                Text { text: file.size; color: Theme.text2; font-family: Theme.mono; font-size: 11px; }
                            }
                            file-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.command("reveal-file:" + file.path); }
                                double-clicked => { root.command("open-file:" + file.path); }
                            }
                        }
                        if root.inspector-files.length == 0 : Text { text: "None yet."; color: Theme.text2; font-size: 11px; }
                    }
                    InspectorSection {
                        title: "OPTIONS";
                        Text { text: root.inspector.options; color: Theme.text; font-family: Theme.mono; font-size: 11px; wrap: word-wrap; }
                    }
                    InspectorSection {
                        title: "LOG";
                        Rectangle {
                            height: 180px;
                            background: Theme.canvas;
                            border-radius: Theme.radius-spine;
                            clip: true;
                            Text {
                                x: 8px; y: parent.height - self.height - 8px;
                                width: parent.width - 16px;
                                text: root.inspector.log;
                                color: Theme.text2; font-family: Theme.mono; font-size: 10px;
                                wrap: char-wrap;
                            }
                        }
                        HorizontalLayout {
                            alignment: start;
                            Pill { label: "Copy Log"; height: 24px; label-size: 11px; clicked => { root.item-action(root.inspector.id, "copy-log"); } }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px; alignment: start;
                        if root.inspector.primary != "" : Pill {
                            label: root.inspector.primary; on: true;
                            clicked => { root.item-action(root.inspector.id, "primary"); }
                        }
                        if root.inspector.has-file && root.inspector.status == S.kept : Pill {
                            label: "Open";
                            clicked => { root.item-action(root.inspector.id, "open"); }
                        }
                        Pill {
                            label: "Remove";
                            clicked => { root.item-action(root.inspector.id, "remove"); }
                        }
                    }
                }
            }
        }

        // A sentence for a moment.
        if root.notice != "" : Rectangle {
            x: (parent.width - self.width) / 2;
            y: parent.height - self.height - 20px;
            width: min(notice-text.preferred-width + 32px, parent.width - 48px);
            height: 36px;
            border-radius: 18px;
            background: Theme.raised;
            border-width: 1px;
            border-color: Theme.rule;
            notice-text := Text {
                text: root.notice; color: Theme.text; font-size: 12px;
                vertical-alignment: center; horizontal-alignment: center;
                width: parent.width - 32px; overflow: elide;
                accessible-live-region: polite;
            }
        }

        // Pages over the window.
        if root.page == 1 : SettingsPage {
            width: parent.width; height: parent.height;
            tab <=> root.settings-tab;
            prefs: root.prefs;
            tools: root.tools;
            js-line: root.js-line;
            js-ok: root.js-ok;
            tools-busy: root.tools-busy;
            tools-note: root.tools-note;
            version: root.version;
            set-option(key, value) => { root.set-option(key, value); }
            command(name) => { root.command(name); }
            tool-action(id, what) => { root.tool-action(id, what); }
            close => { root.page = 0; keys.focus(); }
        }
        if root.page == 2 : FirstRunCard {
            width: parent.width; height: parent.height;
            tools: root.tools;
            folder: root.prefs.folder;
            tools-busy: root.tools-busy;
            missing: root.missing-tool != "";
            command(name) => { root.command(name); }
        }
        if root.page == 3 : Rectangle {
            width: parent.width; height: parent.height;
            background: Theme.scrim;
            TouchArea { clicked => { root.page = 0; } }
            Rectangle {
                width: min(560px, parent.width - 48px);
                height: about-col.preferred-height;
                background: Theme.canvas;
                border-radius: Theme.radius-card;
                border-width: 1px;
                border-color: Theme.rule;
                TouchArea {}
                about-col := VerticalLayout {
                    padding: 32px; padding-top: 20px; spacing: 4px;
                    HorizontalLayout {
                        alignment: end;
                        Pill {
                            label: "Close";
                            hint: "Esc";
                            clicked => { root.page = 0; keys.focus(); }
                        }
                    }
                    AboutCard {
                        version: root.version;
                        command(name) => { root.command(name); }
                    }
                }
            }
        }

        // Dropping a link file or a .torrent anywhere on the window: a 2 px link outline.
        if root.drop-hover : Rectangle {
            border-width: 2px;
            border-color: Theme.link;
            border-radius: 2px;
        }

        // Slint's clipboard, used by copy-text().
        clipboard := TextInput {
            x: -10px; y: -10px; width: 1px; height: 1px;
            opacity: 0;
            read-only: true;
            accessible-role: none;
        }
    }
}

// Shown instead of the main window when Dawnload can't start (another Dawnload owns the data
// folder and isn't listening, say `dawnload run` in a terminal).
export component MessageWindow inherits Window {
    in property <string> message;
    title: "Dawnload";
    icon: @image-url("../assets/icon-256.png");
    preferred-width: 460px;
    background: Theme.canvas;
    default-font-size: 13px;
    callback dismiss();
    VerticalLayout {
        padding: 28px; spacing: 18px;
        HorizontalLayout {
            spacing: 12px;
            CutD { height: 32px; status: S.failed; fill: 1; }
            Text { text: "Dawnload can't start"; color: Theme.text; font-size: 15px; font-weight: 700; vertical-alignment: center; }
        }
        Text { text: root.message; color: Theme.text2; wrap: word-wrap; }
        HorizontalLayout {
            alignment: end;
            Pill { label: "Quit"; on: true; clicked => { root.dismiss(); } }
        }
    }
}

// The tray icon (or menu bar extra): a quiet badge while something downloads or waits, and the
// few things worth doing without the window.
export component Tray inherits SystemTrayIcon {
    in property <string> queue-title: "Pause All";
    in property <bool> queue-enabled: false;
    in property <image> idle-icon: @image-url("../assets/tray.png");
    in property <image> busy-icon: @image-url("../assets/tray-active.png");
    in property <bool> busy;
    in property <string> tip: "Dawnload";
    callback show-window();
    callback queue();
    callback about();
    callback settings();
    callback quit();
    icon: busy ? busy-icon : idle-icon;
    tooltip: root.tip;
    title: "Dawnload";
    clicked => { root.show-window(); }
    Menu {
        MenuItem { title: "Show Dawnload"; activated => { root.show-window(); } }
        MenuSeparator {}
        MenuItem { title: root.queue-title; enabled: root.queue-enabled; activated => { root.queue(); } }
        MenuSeparator {}
        MenuItem { title: "Settings…"; activated => { root.settings(); } }
        MenuItem { title: "About Dawnload"; activated => { root.about(); } }
        MenuSeparator {}
        MenuItem { title: "Quit Dawnload"; activated => { root.quit(); } }
    }
}
